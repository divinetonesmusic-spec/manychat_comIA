# Copie este arquivo para .env.local. Nunca coloque valores reais neste arquivo.
# Ambiente publico do Next/Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=SEU_SUPABASE_ANON_KEY

# Supabase servidor/admin
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SEU_SUPABASE_SERVICE_ROLE_KEY
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SUA-SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres
DATABASE_POOL_MAX=1

# URL publica da aplicacao
APP_BASE_URL=http://127.0.0.1:3000

# Login administrativo
ADMIN_PASSWORD=CRIE_UMA_SENHA_FORTE
ADMIN_SESSION_SECRET=GERE_UM_SEGREDO_ALEATORIO_DE_64_CARACTERES
# Quem pode entrar com e-mail, link ou Google (separe por vírgula). Obrigatório no site no ar:
# vazio, ninguém entra por e-mail; só a senha de administrador (ADMIN_PASSWORD).
ALLOWED_EMAILS=seu-email@exemplo.com

# Worker interno usado pelo cron/webhook para chamadas protegidas
WORKER_SECRET=GERE_OUTRO_SEGREDO_ALEATORIO_DE_64_CARACTERES

# Meta / Instagram
META_API_VERSION=v25.0
INSTAGRAM_APP_ID=SEU_META_APP_ID
INSTAGRAM_APP_SECRET=SEU_META_APP_SECRET
INSTAGRAM_REDIRECT_URI=http://127.0.0.1:3000/api/oauth/callback
WEBHOOK_VERIFY_TOKEN=GERE_UM_TOKEN_ALEATORIO_DE_VERIFICACAO

# Avisos no celular pelo Telegram (opcional). Sem as duas, o UaiFlow funciona igual, só não manda avisos.
# TELEGRAM_BOT_TOKEN: o token que o @BotFather entrega quando você cria o robô.
# TELEGRAM_CHAT_ID: o número da sua conversa com o robô (o @userinfobot mostra). Passo a passo: docs/AVISOS_E_COPIA.md
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# TELEGRAM_WEBHOOK_SECRET (opcional): liga os botões «Aprovar»/«Refazer» e «Mandar»/«Não mandar» no Telegram.
# 24 a 256 letras, números, _ ou - (sem espaço). Gere um, por exemplo: openssl rand -hex 32. Passo a passo: docs/ATUALIZACAO_0008.md
TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_ALLOWED_USER_IDS (opcional): ids de quem pode tocar nos botões, separados por vírgula (num grupo). Vazio = qualquer
# pessoa da conversa TELEGRAM_CHAT_ID. Passo a passo: docs/ATUALIZACAO_0008.md
TELEGRAM_ALLOWED_USER_IDS=
# Relatório de domingo no Telegram (9h, horário de Brasília). Para desligar: RELATORIO_SEMANAL=desligado
RELATORIO_SEMANAL=

# Fila de trabalho do Molde: teto de gastos estimados por mês, em dólares (padrão 50). Passou do teto, os trabalhos que
# custam esperam o mês seguinte (ou a liberação de cada um na página do Molde).
MOLDE_TETO_USD=50
# R2_BACKUP_BUCKET (opcional, recomendado): balde PRIVADO do Cloudflare R2 (sem domínio público) para as cópias de segurança
# do Molde. Usa as mesmas credenciais R2_ACCOUNT_ID / R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY do R2 das mídias (a chave de API
# precisa ter acesso a este balde). Vazio = as cópias ficam no balde das mídias (R2_BUCKET). Veja docs/COPIA_DO_MOLDE.md
R2_BACKUP_BUCKET=
# MOLDE_EXIGIR_POSSE (opcional): 1 = o robô é obrigado a mandar o código de posse do claim (409 sem_posse se faltar).
# Deixe vazio até o robô do Mac estar atualizado. Ordem: colar a 0008 -> publicar o servidor -> atualizar o robô -> só então
# ligar. Passo a passo: docs/ATUALIZACAO_0008.md
MOLDE_EXIGIR_POSSE=
