# Copie este arquivo para .env.local. Nunca coloque valores reais neste arquivo.
# Ambiente publico do Next/Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=SEU_SUPABASE_ANON_KEY

# Supabase servidor/admin
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SEU_SUPABASE_SERVICE_ROLE_KEY
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SUA-SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres
DATABASE_POOL_MAX=1

# URL publica da aplicacao
APP_BASE_URL=http://127.0.0.1:3000

# Login administrativo
ADMIN_PASSWORD=CRIE_UMA_SENHA_FORTE
ADMIN_SESSION_SECRET=GERE_UM_SEGREDO_ALEATORIO_DE_64_CARACTERES

# Worker interno usado pelo cron/webhook para chamadas protegidas
WORKER_SECRET=GERE_OUTRO_SEGREDO_ALEATORIO_DE_64_CARACTERES

# Meta / Instagram
META_API_VERSION=v25.0
INSTAGRAM_APP_ID=SEU_META_APP_ID
INSTAGRAM_APP_SECRET=SEU_META_APP_SECRET
INSTAGRAM_REDIRECT_URI=http://127.0.0.1:3000/api/oauth/callback
WEBHOOK_VERIFY_TOKEN=GERE_UM_TOKEN_ALEATORIO_DE_VERIFICACAO

# Avisos no celular pelo Telegram (opcional). Sem as duas, o UaiFlow funciona igual, só não manda avisos.
# TELEGRAM_BOT_TOKEN: o token que o @BotFather entrega quando você cria o robô.
# TELEGRAM_CHAT_ID: o número da sua conversa com o robô (o @userinfobot mostra). Passo a passo: docs/AVISOS_E_COPIA.md
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
