# Copie este arquivo para .env.local. Nunca coloque valores reais neste arquivo.
# Ambiente publico do Next/Supabase Auth
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=SEU_SUPABASE_ANON_KEY

# Supabase servidor/admin
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SEU_SUPABASE_SERVICE_ROLE_KEY
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SUA-SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres
DATABASE_POOL_MAX=1

# URL publica da aplicacao
APP_BASE_URL=http://127.0.0.1:3000

# Login administrativo
ADMIN_PASSWORD=CRIE_UMA_SENHA_FORTE
ADMIN_SESSION_SECRET=GERE_UM_SEGREDO_ALEATORIO_DE_64_CARACTERES
# Quem pode entrar com e-mail, link ou Google (separe por vírgula). Obrigatório no site no ar:
# vazio, ninguém entra por e-mail; só a senha de administrador (ADMIN_PASSWORD).
ALLOWED_EMAILS=seu-email@exemplo.com

# Worker interno usado pelo cron/webhook para chamadas protegidas
WORKER_SECRET=GERE_OUTRO_SEGREDO_ALEATORIO_DE_64_CARACTERES

# Meta / Instagram
META_API_VERSION=v25.0
INSTAGRAM_APP_ID=SEU_META_APP_ID
INSTAGRAM_APP_SECRET=SEU_META_APP_SECRET
INSTAGRAM_REDIRECT_URI=http://127.0.0.1:3000/api/oauth/callback
WEBHOOK_VERIFY_TOKEN=GERE_UM_TOKEN_ALEATORIO_DE_VERIFICACAO

# Música do Instagram nos Reels (opcional): app da Meta com o produto "Login do Facebook" (ID e chave secreta do app,
# em Configurações > Básico; não é o ID do app do Instagram). Sem as duas, o UaiFlow funciona igual, só sem música.
# FACEBOOK_REDIRECT_URI (opcional): só se for diferente de APP_BASE_URL + /api/oauth/facebook/callback.
# Passo a passo e a migração 0009: docs/musica-instagram.md
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI=

# Outras redes (opcional): publicar o mesmo Reel no Threads e no YouTube Shorts (o Facebook/Página usa o app acima).
# Sem as variáveis de uma rede, o botão dela em Perfis avisa que falta configurar e nada mais muda.
# Passo a passo e a migração 0010: docs/redes-e-vendas.md
THREADS_APP_ID=
THREADS_APP_SECRET=
# THREADS_REDIRECT_URI (opcional): só se for diferente de APP_BASE_URL + /api/oauth/threads/callback.
THREADS_REDIRECT_URI=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI (opcional): só se for diferente de APP_BASE_URL + /api/oauth/youtube/callback.
GOOGLE_REDIRECT_URI=
# YOUTUBE_CHUNK_MB (opcional): pedaço do vídeo enviado ao YouTube a cada minuto do relógio (padrão 8, múltiplo de 0,25).
YOUTUBE_CHUNK_MB=

# Vendas por webhook (opcional). Cada plataforma só funciona com o seu segredo; sem ele, o endereço responde 503.
STRIPE_WEBHOOK_SECRET=
WHOP_WEBHOOK_SECRET=
GUMROAD_WEBHOOK_KEY=
# GUMROAD_ACCESS_TOKEN (opcional): confirma cada venda na API do Gumroad antes de gravar (o aviso do Gumroad não é assinado).
GUMROAD_ACCESS_TOKEN=
PAYHIP_API_KEY=
CAKTO_WEBHOOK_SECRET=
# Mais 10 plataformas (precisam da atualização 0012; passo a passo e o endereço de cada uma: docs/ATUALIZACAO_0012.md).
# Hotmart: o token "hottok" (Ferramentas → Webhook). Endereço: /api/webhooks/hotmart
HOTMART_HOTTOK=
# Kiwify: o token do webhook (Apps → Webhooks). Endereço: /api/webhooks/kiwify
KIWIFY_WEBHOOK_TOKEN=
# Eduzz: o segredo do webhook (Console → Webhooks). Endereço: /api/webhooks/eduzz
EDUZZ_WEBHOOK_SECRET=
# Monetizze: a "chave única" do postback (Ferramentas → Postback). Endereço: /api/webhooks/monetizze
MONETIZZE_CHAVE_UNICA=
# Braip: a chave única de autenticação do postback. Endereço: /api/webhooks/braip
BRAIP_AUTH_KEY=
# Ticto: o token do postback. Endereço: /api/webhooks/ticto
TICTO_WEBHOOK_TOKEN=
# Perfect Pay: o token do webhook. Endereço: /api/webhooks/perfectpay
PERFECTPAY_WEBHOOK_TOKEN=
# Digistore24: a senha (passphrase) da conexão IPN. Endereço: /api/webhooks/digistore24
DIGISTORE24_IPN_PASSPHRASE=
# ClickBank: a "Secret Key" da conta (Settings → My Site). Endereço (Instant Notification URL): /api/webhooks/clickbank
CLICKBANK_SECRET_KEY=
# Lemon Squeezy: o "signing secret" do webhook (Settings → Webhooks). Endereço: /api/webhooks/lemonsqueezy
LEMONSQUEEZY_WEBHOOK_SECRET=

# E-mail do pedido de depoimento, do e-mail de reserva do desafio de 5 dias e do material grátis da página de entrega (opcional; 0011: docs/vendas-escada.md; 0017: docs/ATUALIZACAO_0017.md; Molde v138: docs/API_MOLDE_JOBS.md).
# Sem RESEND_API_KEY e EMAIL_REMETENTE nada sai por e-mail: o painel Vendas mostra o link de cada pedido para mandar à mão.
# RESEND_API_KEY: chave da API do Resend (resend.com), com o domínio do remetente verificado lá. É segredo.
RESEND_API_KEY=
# EMAIL_REMETENTE: quem envia, ex.: Nicolas <oi@seu-dominio.com> (o domínio precisa estar verificado no Resend).
EMAIL_REMETENTE=
# EMAIL_RESPONDER_PARA (opcional): para onde vão as respostas do e-mail.
EMAIL_RESPONDER_PARA=
# EMAIL_ENDERECO_POSTAL (opcional, recomendado nos EUA pela CAN-SPAM): endereço postal no rodapé do e-mail.
EMAIL_ENDERECO_POSTAL=

# Contagem de visitas das páginas públicas (/q, /e, /p) pelo Umami Cloud (opcional, grátis; passo a passo: docs/ATUALIZACAO_0017.md).
# UMAMI_WEBSITE_ID: o Website ID do site no Umami Cloud. Sem ele, as páginas não carregam nenhum script de fora.
UMAMI_WEBSITE_ID=
# UMAMI_SRC (opcional): só para um Umami próprio; o padrão é https://cloud.umami.is/script.js
UMAMI_SRC=

# Avisos no celular pelo Telegram (opcional). Sem as duas, o UaiFlow funciona igual, só não manda avisos.
# TELEGRAM_BOT_TOKEN: o token que o @BotFather entrega quando você cria o robô.
# TELEGRAM_CHAT_ID: o número da sua conversa com o robô (o @userinfobot mostra). Passo a passo: docs/AVISOS_E_COPIA.md
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# TELEGRAM_WEBHOOK_SECRET (opcional): liga os botões «Aprovar»/«Refazer» e «Mandar»/«Não mandar» no Telegram.
# 24 a 256 letras, números, _ ou - (sem espaço). Gere um, por exemplo: openssl rand -hex 32. Passo a passo: docs/ATUALIZACAO_0008.md
TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_ALLOWED_USER_IDS (opcional): ids de quem pode tocar nos botões, separados por vírgula (num grupo). Vazio = qualquer
# pessoa da conversa TELEGRAM_CHAT_ID. Com texto mas nenhum id numérico válido (ex.: @nome), NINGUÉM pode tocar nos botões.
# Passo a passo: docs/ATUALIZACAO_0008.md
TELEGRAM_ALLOWED_USER_IDS=
# TELEGRAM_PROGRESSO (opcional): a mensagem de progresso de cada vídeo do Molde (uma só, editada a cada etapa; 0020).
# Vazio = ligada. Para desligar: TELEGRAM_PROGRESSO=0
TELEGRAM_PROGRESSO=
# Relatório de domingo no Telegram (9h, horário de Brasília). Para desligar: RELATORIO_SEMANAL=desligado
RELATORIO_SEMANAL=

# Fila de trabalho do Molde: teto de gastos estimados por mês, em dólares (padrão 50). Passou do teto, os trabalhos que
# custam esperam o mês seguinte (ou a liberação de cada um na página do Molde).
MOLDE_TETO_USD=50
# PAGINAS_BASE_URL (opcional): o seu domínio próprio ligado neste mesmo site do Netlify (ex.: https://oracaodamanha.com.br).
# Os links das páginas de venda do Molde (/v/<nome>, 0020) saem com ele. Vazio = o APP_BASE_URL. Veja docs/ATUALIZACAO_0020.md
PAGINAS_BASE_URL=
# R2_BACKUP_BUCKET (opcional, recomendado): balde PRIVADO do Cloudflare R2 (sem domínio público) para as cópias de segurança
# do Molde. Usa as mesmas credenciais R2_ACCOUNT_ID / R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY do R2 das mídias (a chave de API
# precisa ter acesso a este balde). Vazio = as cópias ficam no balde das mídias (R2_BUCKET). Veja docs/COPIA_DO_MOLDE.md
R2_BACKUP_BUCKET=
# MOLDE_EXIGIR_POSSE (opcional): 1 = o robô é obrigado a mandar o código de posse do claim (409 sem_posse se faltar).
# Deixe vazio até o robô do Mac estar atualizado. Ordem: colar a 0008 -> publicar o servidor -> atualizar o robô -> só então
# ligar. Passo a passo: docs/ATUALIZACAO_0008.md
MOLDE_EXIGIR_POSSE=
# MOLDE_ORQUESTRADOR_TOKEN (opcional, v135): a chave só do orquestrador do Molde (abre só /api/molde/fila; 24+ letras e números,
# ex.: openssl rand -hex 32). Vazio = o orquestrador usa o MOLDE_API_TOKEN. Passo a passo: docs/ATUALIZACAO_0019.md
MOLDE_ORQUESTRADOR_TOKEN=
# MOLDE_MCP_TOKEN (opcional, v135): a chave do conector do Claude (/api/mcp). Vazio = o conector fica desligado (503).
# 24+ letras e números (openssl rand -hex 32), diferente das outras. Passo a passo: docs/MOLDE_MCP.md
MOLDE_MCP_TOKEN=
